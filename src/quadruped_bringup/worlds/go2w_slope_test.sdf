<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="go2w_slope_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Keep the Gazebo Harmonic system plugins from gz-sim8's empty.sdf. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Each watertight mesh starts at x=1.5, z=0 and combines a quintic-angle
      entry, an exact 5 m constant slope, a quintic-angle crest, and a 2 m
      horizontal top. All contact surfaces retain the original dry-concrete
      mu / mu2 defaults; go2w_reference.launch.py applies runtime overrides.
      Meshes are reproducible with scripts/generate_curved_ramps.py.
    -->
    <model name="ramp_15_deg">
      <static>true</static>
      <pose>1.5 -6.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>package://quadruped_bringup/worlds/go2w_curved_ramp_15.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://quadruped_bringup/worlds/go2w_curved_ramp_15.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.08 0.25 0.85 1</ambient>
            <diffuse>0.08 0.25 0.85 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="ramp_30_deg">
      <static>true</static>
      <pose>1.5 -2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>package://quadruped_bringup/worlds/go2w_curved_ramp_30.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://quadruped_bringup/worlds/go2w_curved_ramp_30.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.08 0.65 0.18 1</ambient>
            <diffuse>0.08 0.65 0.18 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="ramp_35_deg">
      <static>true</static>
      <pose>1.5 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>package://quadruped_bringup/worlds/go2w_curved_ramp_35.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://quadruped_bringup/worlds/go2w_curved_ramp_35.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>1.0 0.45 0.04 1</ambient>
            <diffuse>1.0 0.45 0.04 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="ramp_45_deg">
      <static>true</static>
      <pose>1.5 6.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>package://quadruped_bringup/worlds/go2w_curved_ramp_45.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://quadruped_bringup/worlds/go2w_curved_ramp_45.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.85 0.06 0.06 1</ambient>
            <diffuse>0.85 0.06 0.06 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual-only approach centre lines; they have no collision geometry. -->
    <model name="approach_marker_15_deg">
      <static>true</static>
      <pose>-1.25 -6.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.5 0.10 0.01</size></box></geometry>
          <material>
            <ambient>0.08 0.25 0.85 1</ambient>
            <diffuse>0.08 0.25 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="approach_marker_30_deg">
      <static>true</static>
      <pose>-1.25 -2.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.5 0.10 0.01</size></box></geometry>
          <material>
            <ambient>0.08 0.65 0.18 1</ambient>
            <diffuse>0.08 0.65 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="approach_marker_35_deg">
      <static>true</static>
      <pose>-1.25 2.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.5 0.10 0.01</size></box></geometry>
          <material>
            <ambient>1.0 0.45 0.04 1</ambient>
            <diffuse>1.0 0.45 0.04 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="approach_marker_45_deg">
      <static>true</static>
      <pose>-1.25 6.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.5 0.10 0.01</size></box></geometry>
          <material>
            <ambient>0.85 0.06 0.06 1</ambient>
            <diffuse>0.85 0.06 0.06 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
