<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_name)">
  <xacro:arg name="robot_name" default="generic_quadruped"/>

  <xacro:property name="body_length" value="0.55"/>
  <xacro:property name="body_width" value="0.24"/>
  <xacro:property name="body_height" value="0.14"/>
  <xacro:property name="hip_offset_x" value="0.22"/>
  <xacro:property name="hip_offset_y" value="0.11"/>
  <xacro:property name="thigh_length" value="0.20"/>
  <xacro:property name="calf_length" value="0.20"/>

  <material name="body_gray">
    <color rgba="0.25 0.28 0.30 1.0"/>
  </material>
  <material name="leg_dark">
    <color rgba="0.08 0.09 0.10 1.0"/>
  </material>
  <material name="foot_orange">
    <color rgba="0.95 0.43 0.12 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="body_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="12.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0" iyy="0.32" iyz="0.0" izz="0.38"/>
    </inertial>
  </link>

  <xacro:macro name="three_dof_leg" params="prefix hip_x hip_y">
    <link name="${prefix}_hip_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.10"/>
        </geometry>
        <material name="leg_dark"/>
      </visual>
    </link>

    <joint name="${prefix}_hip_abduction_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_hip_link"/>
      <origin xyz="${hip_x} ${hip_y} 0.0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.8" upper="0.8" effort="40.0" velocity="20.0"/>
    </joint>

    <link name="${prefix}_thigh_link">
      <visual>
        <origin xyz="0 0 ${-thigh_length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.018" length="${thigh_length}"/>
        </geometry>
        <material name="leg_dark"/>
      </visual>
    </link>

    <joint name="${prefix}_hip_pitch_joint" type="revolute">
      <parent link="${prefix}_hip_link"/>
      <child link="${prefix}_thigh_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.8" upper="1.8" effort="40.0" velocity="20.0"/>
    </joint>

    <link name="${prefix}_calf_link">
      <visual>
        <origin xyz="0 0 ${-calf_length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.014" length="${calf_length}"/>
        </geometry>
        <material name="leg_dark"/>
      </visual>
    </link>

    <joint name="${prefix}_knee_pitch_joint" type="revolute">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_calf_link"/>
      <origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.8" upper="0.1" effort="40.0" velocity="20.0"/>
    </joint>

    <link name="${prefix}_foot_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.026"/>
        </geometry>
        <material name="foot_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.026"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_foot_fixed_joint" type="fixed">
      <parent link="${prefix}_calf_link"/>
      <child link="${prefix}_foot_link"/>
      <origin xyz="0 0 ${-calf_length}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:three_dof_leg prefix="front_left" hip_x="${hip_offset_x}" hip_y="${hip_offset_y}"/>
  <xacro:three_dof_leg prefix="front_right" hip_x="${hip_offset_x}" hip_y="${-hip_offset_y}"/>
  <xacro:three_dof_leg prefix="rear_left" hip_x="${-hip_offset_x}" hip_y="${hip_offset_y}"/>
  <xacro:three_dof_leg prefix="rear_right" hip_x="${-hip_offset_x}" hip_y="${-hip_offset_y}"/>
</robot>
