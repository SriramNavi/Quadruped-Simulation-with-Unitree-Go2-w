<?xml version="1.0"?>
<package format="3">
  <name>quadruped_control</name>
  <version>0.0.1</version>
  <description>Robot-agnostic low-level quadruped controllers and torque command abstractions.</description>
  <maintainer email="dev@example.com">Surivona Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>quadruped_kinematics</exec_depend>
  <exec_depend>quadruped_msgs</exec_depend>
  <exec_depend>quadruped_utils</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
